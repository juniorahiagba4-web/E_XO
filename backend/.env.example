APP_NAME="La Perle d'Or"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev without Docker uses SQLite; docker-compose overrides these to MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=eventloc
# DB_USERNAME=eventloc
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@eventloc.tg"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated list of allowed frontend origins for the API, e.g.
# https://eventloc.tg,https://www.eventloc.tg — leave as * for local dev only.
CORS_ALLOWED_ORIGINS=*

# Free DeepL API key (deepl.com/pro-api, "DeepL API Free" plan) used to
# auto-fill the English name/description of items and categories from the
# French text entered in the admin. Leave blank to disable — the English
# fields simply stay empty for manual entry, nothing breaks.
DEEPL_API_KEY=
DEEPL_API_FREE=true

VITE_APP_NAME="${APP_NAME}"
