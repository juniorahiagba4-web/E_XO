# Modèle de configuration pour un environnement de PRODUCTION.
# Ne pas copier tel quel : partir de `.env.example`, puis appliquer les
# différences ci-dessous (elles ne sont pas exhaustives — seules les valeurs
# qui DOIVENT changer par rapport au développement local sont listées).

# --- Critique : à ne jamais laisser aux valeurs de dev en production ---

APP_ENV=production
APP_DEBUG=false
APP_URL=https://laperledor.tg

# Générée spécifiquement pour cet environnement (php artisan key:generate),
# jamais copiée depuis un environnement de dev/staging.
APP_KEY=

# Domaine(s) réel(s) du frontend uniquement — jamais "*" en production.
CORS_ALLOWED_ORIGINS=https://laperledor.tg,https://www.laperledor.tg

LOG_LEVEL=error

# --- Base de données réelle (MySQL, pas SQLite) ---

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laperledor
DB_USERNAME=laperledor
DB_PASSWORD=

# --- Recommandé ---

SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# Durée de vie des tokens API (Sanctum) en minutes. 30 jours par défaut si
# absent ; à réduire si le cas d'usage l'exige (voir config/sanctum.php).
# SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

MAIL_MAILER=smtp
