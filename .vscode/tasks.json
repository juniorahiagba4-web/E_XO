{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Démarrer le site (setup + dev)",
      "dependsOn": ["Setup (première fois)", "Dev: Frontend (npm run dev)"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Setup (première fois)",
      "type": "shell",
      "command": "make setup",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Backend (docker compose up)",
      "type": "shell",
      "command": "make up",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Frontend (npm run dev)",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "dependsOn": ["Dev: Backend (docker compose up)"],
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      }
    },
    {
      "label": "Backend: migrate + seed (données de démo)",
      "type": "shell",
      "command": "make fresh",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Arrêter les conteneurs backend",
      "type": "shell",
      "command": "make down",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
